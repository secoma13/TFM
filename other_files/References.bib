@Article{teleman_Newlander_Niremberg,
author={Teleman, Andrei},
title={The Newlander-Nirenberg Theorem for Principal Bundles},
journal={Mathematische Zeitschrift},
year={2024},
month={Jan},
day={03},
volume={306},
number={2},
pages={20},
abstract={Let G be an arbitrary (not necessarily isomorphic to a closed subgroup of {\$}{\$}{\backslash}textrm{\{}GL{\}}(r,{\backslash}mathbb {\{}C{\}}){\$}{\$}) complex Lie group, U a complex manifold and {\$}{\$}p:P{\backslash}rightarrow U{\$}{\$}a {\$}{\$}{\backslash}mathcal {\{}C{\}}^{\backslash}infty {\$}{\$}principal G-bundle on U. We introduce and study the space {\$}{\$}{\backslash}mathcal {\{}J{\}}^{\backslash}kappa {\_}P{\$}{\$}of bundle almost complex structures of H{\"o}lder class {\$}{\$}{\backslash}mathcal {\{}C{\}}^{\backslash}kappa {\$}{\$}on P. To any {\$}{\$}J{\backslash}in {\backslash}mathcal {\{}J{\}}^{\backslash}kappa {\_}P{\$}{\$}we associate an {\$}{\$}{\backslash}textrm{\{}Ad{\}}(P){\$}{\$}-valued form {\$}{\$}{\backslash}mathfrak {\{}f{\}}{\_}J{\$}{\$}of type (0,2) on U which should be interpreted as the obstruction to the integrability of J. For {\$}{\$}{\backslash}kappa {\backslash}ge 1{\$}{\$}we have {\$}{\$}{\backslash}mathfrak {\{}f{\}}{\_}J{\backslash}in {\backslash}mathcal {\{}C{\}}^{\{}{\backslash}kappa -1{\}}(U,{\{}{\backslash}mathchoice{\{}{\{}{\backslash}textstyle {\backslash}bigwedge {\}}{\}}{\{}{\{}{\backslash}bigwedge {\}}{\}}{\{}{\{}{\backslash}textstyle {\backslash}wedge {\}}{\}}{\{}{\{}{\backslash}scriptstyle {\backslash}wedge {\}}{\}}{\}}{\backslash}hspace{\{}-2pt{\}}^{\{}0,2{\}}{\_}{\{}{\backslash},{\backslash},U{\}}{\backslash}otimes {\backslash}text {\{}Ad{\}}(P)){\$}{\$}whereas, for {\$}{\$}{\backslash}kappa {\backslash}in [0,1){\$}{\$}, {\$}{\$}{\backslash}mathfrak {\{}f{\}}{\_}J{\$}{\$}is a form with distribution coefficients. Let {\$}{\$}J{\backslash}in {\backslash}mathcal {\{}J{\}}^{\backslash}kappa {\_}P{\$}{\$}with {\$}{\$}{\backslash}kappa {\backslash}in (0,+{\backslash}infty ]{\{}{\backslash}setminus {\}}{\backslash}mathbb {\{}N{\}}{\$}{\$}. We prove that J admits locally J-pseudo-holomorphic sections of class {\$}{\$}{\backslash}mathcal {\{}C{\}}^{\{}{\backslash}kappa +1{\}}{\$}{\$}if and only if {\$}{\$}{\backslash}mathfrak {\{}f{\}}{\_}J=0{\$}{\$}. If this is the case, J defines a holomorphic reduction of the underlying {\$}{\$}{\backslash}mathcal {\{}C{\}}^{\{}{\backslash}kappa +1{\}}{\$}{\$}-bundle of P in the sense of the theory of principal bundles on complex manifolds. The proof is based on classical regularity results for the {\$}{\$}{\backslash}bar{\{}{\backslash}partial {\}}{\$}{\$}-Neumann operator on compact, strictly pseudo-convex complex manifolds with boundary. The result will be used in forthcoming articles dedicated to moduli spaces of holomorphic bundles (on a compact complex manifold X) framed along a real hypersurface {\$}{\$}S{\backslash}subset X{\$}{\$}.},
issn={1432-1823},
doi={10.1007/s00209-023-03413-4},
}



